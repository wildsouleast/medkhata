# Copy to .env for local development. Never commit real values.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
SESSION_SECRET=change-me-to-a-long-random-string
# Razorpay (Dashboard -> Account & Settings -> API Keys). Leave empty until the account is ready.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional: shown on the Contact page and in the legal pages
BUSINESS_NAME=MedKhata
CONTACT_EMAIL=
CONTACT_PHONE=
BUSINESS_ADDRESS=
# Optional: key for the /admin page
ADMIN_KEY=
